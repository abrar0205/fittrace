# Copy to apps/api/.env (or export) and adjust. Never commit real credentials.
FITTRACE_DATABASE_URL=postgresql+psycopg://fittrace:CHANGE_ME@localhost:5432/fittrace
FITTRACE_TEST_DATABASE_URL=postgresql+psycopg://fittrace:CHANGE_ME@localhost:5432/fittrace_test
FITTRACE_DATA_DIR=./data
FITTRACE_CORS_ORIGINS=["http://localhost:5173"]
FITTRACE_LOG_LEVEL=INFO
FITTRACE_LOG_JSON=true
# Public demo safeguards
FITTRACE_DEMO_READONLY=false
FITTRACE_MAX_VERIFICATION_UNITS=200
FITTRACE_MAX_QUEUED_JOBS=4
# Run the job worker inside the API process (single-service hosting)
FITTRACE_RUN_WORKER_IN_PROCESS=false
FITTRACE_SEED_ON_START=false
# Frontend (only when the UI is hosted separately from the API)
VITE_API_BASE=
